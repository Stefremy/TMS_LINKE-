NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public production origins (no path; localhost can keep its own local values)
OPS_ORIGIN=https://ops.toke.pt
PUBLIC_SITE_ORIGIN=https://www.toke.pt
# Client portal invitations (public HTTPS origin and verified Resend sender)
CLIENT_PORTAL_ORIGIN=https://app.toke.pt
RESEND_API_KEY=
STORE_FROM_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CTT Expresso
CTT_CONTRACT_ID=
CTT_CLIENT_ID=
CTT_AUTHENTICATION_ID=
CTT_USER_ID=
# Company requesting the pickup; independent of each pickup location.
CTT_PICKUP_REQUESTER_NAME=
CTT_PICKUP_REQUESTER_PHONE=
CTT_PICKUP_REQUESTER_MOBILE=
CTT_PICKUP_REQUESTER_EMAIL=
CTT_DISTRIBUTION_CHANNEL=99
CTT_ENVIRONMENT=production
CTT_DEFAULT_SUBPRODUCT=EMSF056.01
CTT_WEBHOOK_SECRET=

# Correos Express
CORREOS_SOLICITANTE=
CORREOS_COD_RTE=
CORREOS_USER=
CORREOS_PASSWORD=
CORREOS_ENVIRONMENT=production

# Cron & Testing
CRON_SECRET=
ENABLE_PROVIDER_TESTS=false

# Ajustes automáticos de peso (ativar só depois da migração 20261023160000).
# Usa a tarifa guardada na criação; não altera faturas/extratos já emitidos.
CARRIER_WEIGHT_REPRICING_ENABLED=false
# Unidade de _PesoReal confirmada pelos CTT: g ou kg. Vazio bloqueia ajustes CTT.
CTT_MEASURED_WEIGHT_UNIT=
